# Copy this file to frontend/.env. These values end up in the browser, so never put secrets here.

# Address of the backend API (used when the site is not running on localhost)
VITE_API_URL=https://your-backend.onrender.com/api
VITE_GOOGLE_CLIENT_ID=
# PUBLIC VAPID key (the private one stays in the backend)
VITE_VAPID_PUBLIC_KEY=
