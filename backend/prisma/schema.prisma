generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TrackingStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  googleId  String?  @unique
  displayName String?
  avatarUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackedProducts TrackedProduct[]
  pushSubscriptions PushSubscription[]
}

model Marketplace {
  id        String   @id @default(uuid())
  name      String   @unique
  baseUrl   String
  createdAt DateTime @default(now())

  listings ProductListing[]
}

model Product {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings        ProductListing[]
  trackedProducts TrackedProduct[]
}

model ProductListing {
  id                  String   @id @default(uuid())
  externalId         String
  url                 String
  imageUrl           String?
  currentPrice       Decimal  @db.Decimal(12, 2)
  previousPrice      Decimal? @db.Decimal(12, 2)
  lowestObservedPrice Decimal  @db.Decimal(12, 2)
  currency           String   @default("USD")
  lastCheckedAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  productId     String
  marketplaceId String

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  priceHistory PriceHistory[]

  @@unique([marketplaceId, externalId])
  @@unique([productId, marketplaceId])
  @@index([productId])
  @@index([marketplaceId])
}

model TrackedProduct {
  id          String         @id @default(uuid())
  targetPrice Decimal        @db.Decimal(12, 2)
  status      TrackingStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  alert Alert?

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([status])
}

model PriceHistory {
  id        String   @id @default(uuid())
  price     Decimal  @db.Decimal(12, 2)
  currency  String
  checkedAt DateTime @default(now())

  listingId String
  listing   ProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, checkedAt])
}

model Alert {
  id              String   @id @default(uuid())
  isBelowTarget   Boolean  @default(false)
  lastTriggeredAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trackedProductId String @unique
  trackedProduct   TrackedProduct @relation(fields: [trackedProductId], references: [id], onDelete: Cascade)

  notifications Notification[]
}

model Notification {
  id        String             @id @default(uuid())
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  alertId String
  alert   Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}