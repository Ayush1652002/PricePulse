# Copy this file to backend/.env and fill in the values. Never commit the real .env file.

# ---------- Required (the server will not start without these two) ----------
DATABASE_URL=postgresql://pricepulse:pricepulse@localhost:5432/pricepulse
# A long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ---------- Server ----------
PORT=3000
NODE_ENV=development
# Public address of this API (used for the eBay verification endpoint)
PUBLIC_API_URL=http://localhost:3000
# Extra websites allowed to call the API, comma separated (localhost and the Vercel site are built in)
CLIENT_URL=
# Turn on CSRF protection AFTER the updated frontend is deployed: true / false
REQUIRE_CSRF_HEADER=false
# Login session length in days
AUTH_SESSION_EXPIRY_DAYS=30
# Optional: separate secret for hashing OTP codes (falls back to JWT_SECRET)
OTP_SECRET=

# ---------- Google login ----------
GOOGLE_CLIENT_ID=

# ---------- Email (Brevo) ----------
BREVO_API_KEY=
BREVO_FROM_NAME=PricePulse
# Sender used for OTP emails
BREVO_FROM_EMAIL=
# Sender used for price-alert emails
SMTP_USER=

# ---------- Browser push notifications (Web Push / VAPID) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Redis (price-check queue). Leave empty to use the in-memory fallback ----------
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Price checking ----------
PRICE_CHECK_INTERVAL_MINUTES=5
# COUNT keeps the latest N rows, DAYS keeps the last N days
PRICE_HISTORY_RETENTION_STRATEGY=COUNT
PRICE_HISTORY_MAX_RECORDS=30
PRICE_HISTORY_RETENTION_DAYS=30

# ---------- eBay verification endpoint ----------
EBAY_VERIFICATION_TOKEN=

# ---------- Tests only ----------
# Database used by `npm test`. The name MUST contain "test" (tests delete data).
TEST_DATABASE_URL=postgresql://pricepulse:pricepulse@localhost:5432/pricepulse_test
